flowchart TB
    subgraph ROW1[" "]
        direction LR
        SOURCES["<b>1 · Dati sorgente</b><br/>Snapshot customer e product nel Run 1<br/>3 run orders · batch late-arriving"]
        INGESTION["<b>2 · Ingestion raw</b><br/>Validazione · checksum · transazione ACID<br/>DuckDB raw + manifest idempotente"]
        TRANSFORM["<b>3 · Trasformazioni dbt</b><br/>Staging · deduplicazione · upsert<br/>order_line_id + prevalenza deterministica"]
        SOURCES --> INGESTION --> TRANSFORM
    end

    subgraph ROW2[" "]
        direction LR
        MARTS["<b>4 · Star schema e qualità</b><br/>fct_order_lines · dim_customers · dim_products<br/>Unknown · test · incremental = full refresh"]
        DELIVERY["<b>5 · Snapshot e fruizione</b><br/>ecommerce.duckdb versionato<br/>Streamlit read-only · KPI e analisi"]
        MARTS --> DELIVERY
    end

    TRANSFORM -->|"10 insert · 5 correction · replay idempotente"| MARTS

    ORDINARY["5.000 chiavi iniziali<br/>Run 1 · Run 2 · Run 3"] -.-> INGESTION
    LATE["Late-arriving separato<br/>10 nuove · 5 correction"] -.-> INGESTION
