    classDef source fill:#EFF5FF,stroke:#255FCC,color:#172033,stroke-width:1.5px;
    classDef process fill:#EFFAF3,stroke:#14733D,color:#172033,stroke-width:1.5px;
    classDef transform fill:#FFF7ED,stroke:#9A4F00,color:#172033,stroke-width:1.5px;
    classDef mart fill:#F5F1FF,stroke:#7C3AED,color:#172033,stroke-width:1.5px;
    classDef delivery fill:#FFF0F5,stroke:#A61B4D,color:#172033,stroke-width:1.5px;
    classDef context fill:#FFFFFF,stroke:#8A94A8,color:#526079,stroke-dasharray:4 3;

    class SOURCES source;
    class INGESTION process;
    class TRANSFORM transform;
    class MARTS,QUALITY mart;
    class DELIVERY delivery;
    class ORDINARY,LATE,EVOLUTION context;
    style ROW1 fill:#FFFFFF,stroke:#FFFFFF
    style ROW2 fill:#FFFFFF,stroke:#FFFFFF
